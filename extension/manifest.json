{
  "manifest_version": 3,
  "name": "Collector",
  "version": "0.1.0",
  "description": "Bewaar beelden en pagina's in je Collector: rechtsklik, Alt-klik of de knop in de werkbalk.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js", "scripts": ["bg.js"] },
  "action": { "default_title": "Kies beelden van deze pagina voor Collector", "default_icon": { "16": "icon-16.png", "48": "icon-48.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Kies beelden van deze pagina" } },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_idle" },
    { "matches": ["https://dev.patrickloonstra.nl/collector/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ],
  "browser_specific_settings": { "gecko": { "id": "collector@patrickloonstra.nl", "strict_min_version": "121.0" } }
}
