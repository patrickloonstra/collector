{
  "name": "collector",
  "productName": "Collector",
  "version": "0.1.4",
  "description": "Verzamel, orden en vind beeldreferenties terug. Je bestanden blijven gewone bestanden in je eigen map.",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "serve": "node server/cli.js",
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --mac --publish never"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.65.1"
  },
  "build": {
    "appId": "nl.patrickloonstra.collector",
    "productName": "Collector",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "server/**",
      "ui/**",
      "mcp/**",
      "package.json"
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Collector-${version}.${ext}"
    },
    "dmg": {
      "sign": false,
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 210
        },
        {
          "x": 400,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "Collector ${version}"
    }
  }
}
